# AIROS V3 — Supabase connection config (template).
# Copy this file to `.env` and fill in your REAL values.
# NEVER commit `.env` — it is already gitignored.
#
#   cp database/.env.example .env
#
# Where to find these on the Supabase dashboard:
#   Project Settings -> API        (URL, anon key, service_role key)
#   Project Settings -> Database   (connection string / password)

# Base URL of your Supabase project, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=

# 'service_role' key (backend only). Treated as a master secret: never share,
# never commit, keep it out of logs. Prefer keeping it ONLY in the Supabase
# vault so local tooling cannot leak it.
SUPABASE_SERVICE_ROLE_KEY=

# 'publishable' (a.k.a. anon) key - the one used by scripts/verify_supabase.py
# and scripts/verify_auth0.py. Safe to keep locally, like the URL.
SUPABASE_PUBLISHABLE_KEY=

# Database connection password you chose at project creation.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Auth0 (Slice 3, DEC-003/DEC-014) - Auth0 tenant details (public values only).
# The Client SECRET must stay in the Auth0 dashboard, never here.
# ---------------------------------------------------------------------------

# Your Auth0 tenant domain, e.g. https://airos-v3.eu.auth0.com
AUTH0_DOMAIN=

# Auth0 application Client ID (public, safe to keep here).
AUTH0_CLIENT_ID=

# OAuth audience (optional, only if you set an API audience in Auth0).
AUTH0_AUDIENCE=

# For local verification only: paste a short-lived Auth0 ID token here
# (never commit; the token expires quickly).
AUTH0_ID_TOKEN=

# Gemini API key (Slice 6, DEC-005) - SERVER-SIDE ONLY, never in web/.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=